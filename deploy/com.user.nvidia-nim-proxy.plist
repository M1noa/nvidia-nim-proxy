<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.user.nvidia-nim-proxy</string>
  <key>ProgramArguments</key>
  <array>
    <string>REPLACE_WITH_PATH/nim-proxy</string>
  </array>
  <key>WorkingDirectory</key>
  <string>REPLACE_WITH_PATH</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>REPLACE_WITH_PATH/nim-proxy.log</string>
  <key>StandardErrorPath</key>
  <string>REPLACE_WITH_PATH/nim-proxy.err.log</string>
</dict>
</plist>
